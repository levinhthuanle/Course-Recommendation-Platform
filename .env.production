APP_NAME=Course Recommendation Platform
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

MEILI_MASTER_KEY=replace-with-a-strong-meili-key
MEILISEARCH_MASTER_KEY=replace-with-a-strong-meili-key
MEILI_ENV=production
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_INDEX_NAME=courses

RESOURCES_PATH=/app/Resources
BATCH_SIZE=100
SEARCH_LIMIT=20
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_ONE=4
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_TWO=8

GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=replace-with-a-production-gemini-key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=course_db
DATABASE_URL=postgresql://postgres:replace-with-a-strong-db-password@postgres:5432/course_db

JWT_SECRET=replace-with-a-long-random-jwt-secret

CORS_ORIGINS=https://your-domain.example
VITE_API_BASE_URL=/api
