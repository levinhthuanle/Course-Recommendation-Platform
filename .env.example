# Application Settings
APP_NAME="Course Recommendation Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Meilisearch Settings
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=your_master_key_here
MEILISEARCH_INDEX_NAME=courses

# Data Ingestion Settings
RESOURCES_PATH=/app/Resources
BATCH_SIZE=100

# Search Settings
SEARCH_LIMIT=20
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_ONE=4
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_TWO=8

# PDF Processing Settings
ENABLE_OCR=true
PDF_CHUNK_SIZE=500
PDF_OVERLAP_SIZE=50

# Gemini AI Settings (for chatbot)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Auth Settings
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXP_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production

# Database Configuration (optional - for PostgreSQL)
# Uncomment and set this if using PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@postgres:5432/course_platform

# Production Deployment Notes
# ============================
# For AWS EC2 deployment:
# 1. Update MEILISEARCH_URL to point to Meilisearch service (use docker-compose service name)
# 2. Set JWT_SECRET to a strong random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Set GEMINI_API_KEY from your Google Cloud console
# 4. Update ADMIN_EMAIL and ADMIN_PASSWORD for initial bootstrap
# 5. Update CORS_ORIGINS to include your frontend domain
# 6. Set DEBUG=false in production

