APP_NAME=Course Recommendation Platform
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

MEILI_MASTER_KEY=masterKey123
MEILISEARCH_MASTER_KEY=masterKey123
MEILI_ENV=development
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_INDEX_NAME=courses

RESOURCES_PATH=/app/Resources
BATCH_SIZE=100
SEARCH_LIMIT=20
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_ONE=4
TYPO_TOLERANCE_MIN_WORD_SIZE_FOR_TYPOS_TWO=8

GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=replace-with-a-real-dev-key

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=course_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/course_db

